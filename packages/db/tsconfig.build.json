{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": ["src/schema.ts", "src/index.ts"],
  "exclude": ["src/seed.ts", "src/migrate.ts", "src/client.ts", "src/client-direct.ts"]
}
